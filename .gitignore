coverage.*

# Node / frontend
node_modules/
web/node_modules/
web/.vite/

# Embedded build output (generated by the frontend build before go build).
# Keep the directory (with .gitkeep) so go:embed always has something to embed,
# but ignore the generated assets themselves.
web/dist/*
!web/dist/.gitkeep

