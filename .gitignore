# Binaries
/aeman
/dist/
/bin/

# Go
*.test
*.out
coverage.*

# Helm: local secret overrides and build metadata (never commit credentials)
charts/*/values-secret.yaml
.build-metadata.json

# Node / frontend
node_modules/
web/node_modules/
web/.vite/
web/.tsbuild-node/
web/*.tsbuildinfo

# Embedded build output (generated by the frontend build before go build).
# Keep the directory (with .gitkeep) so go:embed always has something to embed,
# but ignore the generated assets themselves.
web/dist/*
!web/dist/.gitkeep

# Local deploy secrets
.env

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/

# Claude Code (worktrees, session state)
.claude/
