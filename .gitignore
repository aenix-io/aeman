# Binaries
/aeman
/dist/
/bin/

# Go
*.test
*.out
coverage.*

# Node / frontend
node_modules/
web/node_modules/
web/.vite/
web/.tsbuild-node/
web/*.tsbuildinfo

# Embedded build output (generated by the frontend build before go build).
# Keep the directory (with .gitkeep) so go:embed always has something to embed,
# but ignore the generated assets themselves.
web/dist/*
!web/dist/.gitkeep

# Local deploy secrets
.env

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/

# Claude Code (worktrees, session state)
.claude/

# Deploy values holding real credentials. The chart's own values.yaml carries
# the shape; anything matching this pattern is somebody's filled-in copy and
# never belongs in the repository.
charts/**/values-secret.yaml
charts/**/values-*.secret.yaml
*.secret.yaml
