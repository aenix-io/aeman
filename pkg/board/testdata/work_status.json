    {"name": "parked on review", "card": {"parked": true, "stage": "review", "progress": 50}, "status": "backlog"},
    {"name": "parked and locked", "card": {"parked": true, "stage": "locked", "progress": 50}, "status": "backlog"},
    {"name": "review with no date or sprint", "card": {"stage": "review", "progress": 50}, "status": "backlog"},
    {"name": "unplaced", "card": {}, "status": "backlog"},
