# Copy to .env and fill in. Used by docker-compose.

# --- Board repositories ---
# The board's repositories as name=url, comma-separated, the primary first:
# HTTPS clone URLs on GitHub or GitLab (gitlab.com or self-hosted). An empty
# repository becomes a board with `aeman init --repo <url>` first.
AEMAN_REPOS=aeman-db=https://github.com/acme/aeman-db.git

# The server's own credential for the board repositories: fetch, push, and
# the membership checks behind the assignee pickers. Required in the OAuth
# mode. GitHub: a personal access token with `repo`. GitLab: an access token
# with `api` (or `read_api` + `write_repository`) on the repositories.
AEMAN_GIT_TOKEN=

# A repository may carry its own credential: AEMAN_GIT_TOKEN_<NAME>, the
# domain's name from AEMAN_REPOS upper-cased with anything but a letter or a
# digit as an underscore. A board spanning two organisations needs this — one
# token narrow enough for either cannot reach both, and a token wide enough
# for both is wider than either repository needs. AEMAN_GIT_TOKEN covers the
# domains that name none.
#   AEMAN_REPOS=aeman-db=https://github.com/acme/aeman-db.git,founders=https://github.com/acme-founders/aeman-db.git
#   AEMAN_GIT_TOKEN_AEMAN_DB=
#   AEMAN_GIT_TOKEN_FOUNDERS=

# --- Forge ---
# Which forge signs visitors in and answers who may read which repository:
# github or gitlab. Unset, it follows the primary repository's host:
# github.com → github, a host containing "gitlab" → gitlab, anything else →
# github unless AEMAN_GITLAB_URL is set. Fill in exactly ONE of the two
# client id/secret pairs below.
# AEMAN_FORGE=

# --- GitHub OAuth App ---
# Create at: GitHub → Settings → Developer settings → OAuth Apps → New.
#   Homepage URL:               https://aeman.example.com
#   Authorization callback URL: https://aeman.example.com/auth/callback
AEMAN_GITHUB_CLIENT_ID=
AEMAN_GITHUB_CLIENT_SECRET=

# --- GitLab OAuth application ---
# Create at: GitLab → User Settings (or a group's Settings, or the Admin
# area) → Applications → Add new application.
#   Name:         aeman
#   Redirect URI: https://aeman.example.com/auth/callback
#   Confidential: yes
#   Scopes:       read_user, read_api, write_repository
# Copy the Application ID and Secret here.
AEMAN_GITLAB_CLIENT_ID=
AEMAN_GITLAB_CLIENT_SECRET=

# Self-hosted GitLab only: its base URL. Default: https://<host of the
# primary repository>.
# AEMAN_GITLAB_URL=https://gitlab.example.com

# Public origin where users reach aeman. Must match the OAuth callback host.
AEMAN_BASE_URL=https://aeman.example.com

# OAuth scopes (space-separated). Empty means the forge's default:
# GitHub `repo project`, GitLab `read_user read_api write_repository`.
AEMAN_SCOPES=

# Where the session store lives (on a mounted volume). It always persists the
# dynamic MCP client registry across restarts. Sessions (the visitors' forge
# tokens) are written here only when AEMAN_SESSION_KEY is set — encrypted — so
# a restart keeps users signed in and MCP tokens live. Leave the key unset to
# keep sessions in memory only (signed out on restart); no plaintext token ever
# touches disk either way.
AEMAN_SESSION_FILE=/data/sessions.json

# Secret that encrypts persisted sessions at rest (any long random string, e.g.
# `openssl rand -hex 32`). Set it — and keep it stable — to survive restarts;
# changing or losing it just signs everyone out. Store it out of the session
# volume (this .env is separate) so a leak of the volume alone exposes no token.
AEMAN_SESSION_KEY=

# --- TLS (Caddy) ---
# Domain Caddy serves and auto-issues a Let's Encrypt cert for. Point its DNS
# A record at this host and open ports 80/443.
AEMAN_DOMAIN=aeman.example.com

# --- Optional: lock to one board ---
# Set all three to pin the UI to a single board and hide the picker. Users
# whose token can't read it get an access-denied screen.
# AEMAN_OWNER=acme
# AEMAN_BOARD=37
# AEMAN_LOCK_BOARD=true

# Optional: version string baked into the build.
# AEMAN_VERSION=docker
