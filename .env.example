# Copy to .env and fill in. Used by docker-compose.

# --- GitHub OAuth App ---
# Create at: GitHub → Settings → Developer settings → OAuth Apps → New.
#   Homepage URL:               https://aeman.example.com
#   Authorization callback URL: https://aeman.example.com/auth/callback
AEMAN_GITHUB_CLIENT_ID=
AEMAN_GITHUB_CLIENT_SECRET=

# Public origin where users reach aeman. Must match the OAuth callback host.
AEMAN_BASE_URL=https://aeman.example.com

# OAuth scopes (space-separated). repo+project covers Projects v2 + issues.
AEMAN_SCOPES=repo project

# --- TLS (Caddy) ---
# Domain Caddy serves and auto-issues a Let's Encrypt cert for. Point its DNS
# A record at this host and open ports 80/443.
AEMAN_DOMAIN=aeman.example.com

# --- Optional: lock to one board ---
# Set all three to pin the UI to a single project and hide the picker. Users
# whose token can't read it get an access-denied screen.
# AEMAN_OWNER=aenix-org
# AEMAN_PROJECT=37
# AEMAN_LOCK_BOARD=true

# Optional: version string baked into the build.
# AEMAN_VERSION=docker
